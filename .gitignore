# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/

# Training artifacts
*.pt
*.pth
*.pb
*.ckpt
*.ckpt.*
lcurve.out
checkpoint
model.ckpt*
out.json
input_v2_compat.json

# Data. Datasets are never vendored. Tracking a bare type.raw without its
# set.000/*.npy just leaves a confusing fragment in a fresh clone.
*.npy
*.hdf5
*.h5

# Tool caches
.pytest_cache/
.ruff_cache/

# Warp / torch caches
.cache/
warp_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Experiment scripts, data and run directories stay local.
experiments/

# Uploaded trajectories and anything derived from them; the LiFSI xyz alone
# is 3.1 GB.
*.xyz
*.traj

# ...except the small, deliberate example structures, which are what makes
# those examples runnable rather than merely readable.
!examples/02-molecules/*.xyz
!examples/03-slab/*.xyz
!examples/06-md_nvalchemi/*.xyz

# Generated example datasets. `type.raw` and `type_map.raw` are not *.npy, so
# without this an example would ship those two files and nothing else -- the
# exact fragment the rule above exists to prevent. Step 1 of each example's
# README regenerates the whole directory in seconds.
examples/*/data/
