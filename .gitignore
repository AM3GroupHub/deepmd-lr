# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/

# Training artifacts
*.pt
*.pth
*.pb
*.ckpt
*.ckpt.*
lcurve.out
checkpoint
model.ckpt*
out.json
input_v2_compat.json

# Data. Datasets are never vendored: examples/README.md says how to rebuild
# them. Tracking a bare type.raw without its set.000/*.npy just leaves a
# confusing fragment in a fresh clone.
*.npy
*.hdf5
*.h5
experiments/water_real/data

# Tool caches
.pytest_cache/
.ruff_cache/

# Warp / torch caches
.cache/
warp_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store

# The example is kept local, not vendored: it points at datasets and
# checkpoints that live outside the repo. No trailing slash -- `data` and
# `run` there are usually symlinks to scratch, and a `dir/` pattern matches
# only real directories.
examples
PLAN.md

# Experiment data and run directories. Scoped deliberately: a bare
# `experiments/` here once swallowed the whole tree, so new analysis scripts
# were silently unaddable while already-tracked ones kept working.
experiments/

# Uploaded trajectories and anything derived from them. The LiFSI xyz alone
# is 3.1 GB; examples/README.md says how to rebuild the dataset from it.
*.xyz
*.traj
