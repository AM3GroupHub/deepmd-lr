# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/

# Training artifacts
*.pt
*.pth
*.pb
*.ckpt
*.ckpt.*
lcurve.out
checkpoint
model.ckpt*
out.json
input_v2_compat.json

# Data. Datasets are never vendored -- examples/water_lr/README.md and
# experiments/RESULTS.md say where each one comes from and how to regenerate
# or copy it in. Tracking a bare type.raw without its set.000/*.npy just
# leaves a confusing fragment in a fresh clone.
*.npy
*.hdf5
*.h5
examples/water_lr/data/
experiments/water_real/data

# Warp / torch caches
.cache/
warp_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Example run directories
examples/**/run_*/

# Experiment data and run directories. Scoped deliberately: a bare
# `experiments/` here once swallowed the whole tree, so new analysis scripts
# were silently unaddable while already-tracked ones kept working.
experiments/**/data/
experiments/**/data_norc/
experiments/**/run_*/
experiments/**/__pycache__/

# Uploaded trajectories and anything derived from them. The LiFSI xyz alone is
# 3.3 GB; experiments/lifsi/TRAINING_LiFSI.md says how to regenerate the
# dataset from it with prepare_dataset.py.
*.xyz
*.traj
experiments/lifsi/data/
