{
  "_comment": "Baseline twin: short-range only, same total step budget as stage 1 + stage 2. Without this there is no way to tell whether the long-range term helped.",
  "model": {
    "type_map": [
      "C",
      "F",
      "H",
      "Li",
      "N",
      "O",
      "S"
    ],
    "descriptor": {
      "type": "dpa4c",
      "rcut": 6.0,
      "channels": 32,
      "lmax": 2,
      "basis_type": "bessel",
      "n_radial": 16,
      "radial_modes": 4,
      "precision": "float32",
      "seed": 1
    },
    "fitting_net": {
      "neuron": [
        128,
        128,
        128
      ],
      "resnet_dt": false,
      "activation_function": "silu",
      "precision": "float32",
      "seed": 1
    }
  },
  "learning_rate": {
    "type": "exp",
    "start_lr": 0.001,
    "stop_lr": 1e-05
  },
  "loss": {
    "type": "ener",
    "start_pref_e": 1,
    "limit_pref_e": 1,
    "start_pref_f": 100,
    "limit_pref_f": 100
  },
  "training": {
    "training_data": {
      "systems": [
        "./data/train"
      ],
      "batch_size": 1
    },
    "validation_data": {
      "systems": [
        "./data/valid"
      ],
      "batch_size": 1,
      "numb_btch": 5
    },
    "numb_steps": 1900,
    "save_freq": 475,
    "disp_file": "lcurve.out",
    "disp_freq": 50,
    "seed": 1
  }
}