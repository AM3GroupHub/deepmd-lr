{
  "_comment": "Baseline twin: identical to input_joint.json with the long_range block removed. Always train both -- without it you cannot tell whether the long-range term helped.",
  "model": {
    "type_map": [
      "O",
      "H"
    ],
    "descriptor": {
      "type": "dpa4c",
      "rcut": 6.0,
      "channels": 32,
      "lmax": 2,
      "basis_type": "bessel",
      "n_radial": 16,
      "radial_modes": 4,
      "precision": "float64",
      "seed": 1
    },
    "fitting_net": {
      "neuron": [
        128,
        128,
        128
      ],
      "resnet_dt": false,
      "activation_function": "silu",
      "precision": "float64",
      "seed": 1
    }
  },
  "learning_rate": {
    "type": "exp",
    "start_lr": 0.001,
    "stop_lr": 1e-05
  },
  "loss": {
    "type": "ener",
    "start_pref_e": 1,
    "limit_pref_e": 1,
    "start_pref_f": 100,
    "limit_pref_f": 100
  },
  "training": {
    "training_data": {
      "systems": [
        "./data/data_0",
        "./data/data_1",
        "./data/data_2"
      ],
      "batch_size": 1
    },
    "validation_data": {
      "systems": [
        "./data/data_3"
      ],
      "batch_size": 1,
      "numb_btch": 20
    },
    "numb_steps": 20000,
    "save_freq": 2000,
    "disp_file": "lcurve.out",
    "disp_freq": 500,
    "seed": 1
  }
}