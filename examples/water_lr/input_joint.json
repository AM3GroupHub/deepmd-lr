{
  "_comment": "DPA4C + long-range electrostatics on periodic water. See TRAINING.md for how alpha and the mesh were chosen.",
  "model": {
    "type_map": [
      "O",
      "H"
    ],
    "descriptor": {
      "type": "dpa4c",
      "rcut": 6.0,
      "channels": 32,
      "lmax": 2,
      "basis_type": "bessel",
      "n_radial": 16,
      "radial_modes": 4,
      "precision": "float64",
      "seed": 1
    },
    "fitting_net": {
      "neuron": [
        128,
        128,
        128
      ],
      "resnet_dt": false,
      "activation_function": "silu",
      "precision": "float64",
      "seed": 1
    },
    "type": "dp_lr",
    "long_range": {
      "_comment": "Predicts per-atom charges from the shared descriptor; small, it emits one scalar per atom.",
      "charge_net": {
        "neuron": [
          64,
          64
        ],
        "activation_function": "silu",
        "precision": "float64",
        "seed": 1
      },
      "pme": {
        "_comment": "alpha 0.4 pairs with rcut 6.0: erfc(0.4*6) = 7e-4 is left to the network, well inside its horizon.",
        "alpha": 0.4,
        "_comment_mesh": "Fixed mesh, not a spacing: L = 12.44 A / 20 = 0.62 A, comfortably finer than 1/(2*alpha) = 1.25 A. Fixed so the energy stays smooth if the cell moves.",
        "mesh_dimensions": [
          20,
          20,
          20
        ],
        "spline_order": 6
      }
    }
  },
  "learning_rate": {
    "type": "exp",
    "start_lr": 0.001,
    "stop_lr": 1e-05
  },
  "loss": {
    "type": "ener",
    "start_pref_e": 1,
    "limit_pref_e": 1,
    "start_pref_f": 100,
    "limit_pref_f": 100
  },
  "training": {
    "training_data": {
      "systems": [
        "./data/data_0",
        "./data/data_1",
        "./data/data_2"
      ],
      "batch_size": 1
    },
    "validation_data": {
      "systems": [
        "./data/data_3"
      ],
      "batch_size": 1,
      "numb_btch": 20
    },
    "numb_steps": 20000,
    "save_freq": 2000,
    "disp_file": "lcurve.out",
    "disp_freq": 500,
    "seed": 1
  }
}