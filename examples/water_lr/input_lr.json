{
  "_comment": "Phase 4: DPA4C + PME long-range electrostatics, trained jointly.",
  "model": {
    "type": "dp_lr",
    "type_map": [
      "O",
      "H"
    ],
    "descriptor": {
      "type": "dpa4c",
      "rcut": 6.0,
      "channels": 32,
      "lmax": 2,
      "basis_type": "bessel",
      "n_radial": 16,
      "radial_modes": 4,
      "precision": "float64",
      "use_amp": false,
      "seed": 42
    },
    "fitting_net": {
      "neuron": [
        192,
        192,
        192
      ],
      "resnet_dt": false,
      "activation_function": "silu",
      "precision": "float64",
      "seed": 42
    },
    "long_range": {
      "charge_net": {
        "neuron": [
          64,
          64
        ],
        "activation_function": "silu",
        "precision": "float64",
        "seed": 42
      },
      "pme": {
        "rcut": 5.0,
        "alpha": 0.35,
        "mesh_dimensions": [
          16,
          16,
          16
        ],
        "spline_order": 6
      }
    }
  },
  "learning_rate": {
    "type": "exp",
    "start_lr": 0.001,
    "stop_lr": 1e-05
  },
  "loss": {
    "type": "ener",
    "start_pref_e": 0.02,
    "limit_pref_e": 1,
    "start_pref_f": 1000,
    "limit_pref_f": 1
  },
  "training": {
    "training_data": {
      "systems": [
        "./data/data_0",
        "./data/data_1",
        "./data/data_2"
      ],
      "batch_size": 1
    },
    "validation_data": {
      "systems": [
        "./data/data_3"
      ],
      "batch_size": 1,
      "numb_btch": 1
    },
    "numb_steps": 20,
    "save_freq": 20,
    "disp_file": "lcurve.out",
    "disp_freq": 10,
    "seed": 42
  }
}