      "rcut": 6.0,
      "channels": 32,
      "lmax": 2,
      "basis_type": "bessel",
      "n_radial": 16,
      "radial_modes": 4,
      "precision": "float32",
      "seed": 1
    },
    "fitting_net": {
      "neuron": [
        128,
        128,
        128
