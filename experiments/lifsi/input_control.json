    "start_pref_f": 100,
    "limit_pref_f": 100
  },
  "training": {
    "training_data": {
      "systems": [
        "./data/train"
      ],
      "batch_size": 1
    },
    "validation_data": {
      "systems": [
        "./data/valid"
      ],
      "batch_size": 1,
      "numb_btch": 5
    },
    "numb_steps": 400,
    "save_freq": 100,
    "disp_file": "lcurve.out",
    "disp_freq": 25,
    "seed": 1
  }
